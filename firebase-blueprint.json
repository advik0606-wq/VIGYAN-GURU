{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's full name" },
        "photoURL": { "type": "string", "description": "URL to the user's profile photo" }
      },
      "required": ["uid", "email"]
    },
    "Review": {
      "title": "Review",
      "description": "User submitted review and rating",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID of the user who submitted the review" },
        "author": { "type": "string", "description": "Display name of the author" },
        "rating": { "type": "number", "description": "Rating from 1 to 5" },
        "review": { "type": "string", "description": "The textual review" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the review was created" }
      },
      "required": ["uid", "rating", "review", "createdAt"]
    },
    "Message": {
      "title": "Contact Message",
      "description": "Message sent via the contact form",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID of the user who sent the message (if signed in)" },
        "name": { "type": "string", "description": "Sender's name" },
        "email": { "type": "string", "format": "email", "description": "Sender's email" },
        "subject": { "type": "string", "description": "Message subject" },
        "message": { "type": "string", "description": "The message body" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was sent" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "Quiz": {
      "title": "Interactive Scientific Quiz",
      "description": "Custom or AI-generated interactive multiple-choice quiz",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID of the creator" },
        "author": { "type": "string", "description": "Display name of the author" },
        "title": { "type": "string", "description": "Quiz title" },
        "description": { "type": "string", "description": "Quiz description or learning goals" },
        "questions": { "type": "array", "description": "Array of multiple choice questions" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the quiz was created" }
      },
      "required": ["uid", "title", "questions", "createdAt"]
    },
    "FlashcardDeck": {
      "title": "Interactive Flashcard Deck",
      "description": "Custom or AI-generated key definitions study deck",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID of the creator" },
        "author": { "type": "string", "description": "Display name of the author" },
        "title": { "type": "string", "description": "Deck title" },
        "description": { "type": "string", "description": "Deck description" },
        "cards": { "type": "array", "description": "Array of double-sided cards" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the deck was created" }
      },
      "required": ["uid", "title", "cards", "createdAt"]
    },
    "StudyGroup": {
      "title": "Study Group / Circle",
      "description": "Collaborative study circles for students to learn together, chat, and share resources.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Name of the study circle" },
        "description": { "type": "string", "description": "Topics focused on" },
        "members": { "type": "array", "description": "List of user profiles that are members" },
        "sharedNotes": { "type": "array", "description": "Study note logs / group message board" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["title", "members", "createdAt", "createdBy"]
    },
    "WeeklyTest": {
      "title": "Weekly Assessment Log",
      "description": "Results and settings of oral or written weekly scientific tests.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Student UID" },
        "topic": { "type": "string", "description": "Science focus topic" },
        "format": { "type": "string", "enum": ["oral", "written"] },
        "questionText": { "type": "string", "description": "Socratic prompt presented" },
        "userResponse": { "type": "string", "description": "Response input from the student" },
        "score": { "type": "number", "description": "Grade awarded from 0 to 100" },
        "feedback": { "type": "string", "description": "Socratic analysis critique" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "topic", "format", "score", "feedback", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of user reviews"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of contact inquiries"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Collection of learning quizzes"
    },
    "/flashcard_decks/{deckId}": {
      "schema": "FlashcardDeck",
      "description": "Collection of studying flashcard decks"
    },
    "/study_groups/{groupId}": {
      "schema": "StudyGroup",
      "description": "Cooperative group workspaces"
    },
    "/weekly_tests/{testId}": {
      "schema": "WeeklyTest",
      "description": "Historical weekly grades logs"
    }
  }
}
